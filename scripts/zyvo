#!/data/data/com.termux/files/usr/bin/sh
# zyvo — wrapper that disables Android bionic TBI heap pointer tagging
#
# The real zyvo binary is zyvo.bin; this script LD_PRELOAD's libtagfix.so
# (a constructor that calls mallopt to turn off heap tagging) before exec'ing it.
# Without this, Bun/JSC's NaN-boxing clears the 0xB4 top-byte tag on heap
# pointers, causing bionic to SIGABRT on free(): "Pointer tag ... was truncated".
#
# Session-permission mode (zyvo --yolo):
#   Writes a temp config with permission = allow and points OPENCODE_CONFIG at
#   it. OpenCode merges that file ON TOP of the global config, so this session
#   never asks for permission — and because it is a temp file only this process
#   sees, exiting zyvo automatically returns to safe ask-mode. Nothing to undo.
#
# Path resolution order (supports both standalone zip and installed package):
#   zip:      wrapper, zyvo.bin, libtagfix.so all live in the same dir
#   installed: bin/zyvo, libexec/opencode/zyvo.bin, lib/libtagfix.so
#   glibc Linux (Ubuntu proot etc.): ~/.local/bin/zyvo, ~/.local/libexec/zyvo/

set -e

dir="$(cd "$(dirname "$0")" && pwd)"
export ANDROID_ROOT="${ANDROID_ROOT:-/system}"
export TERMUX_VERSION="${TERMUX_VERSION:-zyvo-termux}"
export TMPDIR="${ZYVO_TMPDIR:-${HOME:-/data/data/com.termux/files/home}/tmp}"
export TEMP="$TMPDIR"
export TMP="$TMPDIR"
export OPENCODE_DISABLE_TUI_AUDIO="${OPENCODE_DISABLE_TUI_AUDIO:-1}"
mkdir -p "$TMPDIR" 2>/dev/null || true

# ---- permission mode flags + named session ----
# DEFAULT: auto-allow — ei session e ar kono dhoroner permission prompt
#   ashbe na (temp config, session sesh hole automatically sesh).
# zyvo --safe / --ask : prompt mode — TUI te Allow once / Always allow /
#   Reject dialog ashbe (global config er permission follow hoy).
# zyvo session        : session list dekhao
# zyvo session <naam> : oi naamer session khulo/notun banao — folder soho
#   <base>/zyvo/<naam>/ er modde, chat history auto-resume (--continue).
#   Flags age pore jekono order e: zyvo -y session 1 kaj kore.
YOLO=1
SESSION_MODE=0
SESSION_NAME=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --yolo|-y) YOLO=1; shift; continue;;
        --safe|--ask) YOLO=0; shift; continue;;
        session|sessions)
            SESSION_MODE=1; shift
            [ "$#" -gt 0 ] && { SESSION_NAME="$1"; shift; }
            break;;
        *) break;;
    esac
done

# ---- workspace resolve ----
# Shared storage base (na thakle home) er upor default workspace + named
# sessions thake. Storage-root e hajar hajar file (DCIM, WhatsApp, Android/)
# thake — oi ghor abar khalashi korle phone lag kore ar gorom hoy.
# Notun dedicated folder = halka + fast.
WS_BASE=""
if [ -d /storage/emulated/0 ]; then WS_BASE=/storage/emulated/0
elif [ -d /sdcard ]; then WS_BASE=/sdcard
fi
if [ "$SESSION_MODE" = 1 ]; then
    # named session = folder soho zyvo/ folder er vitore:
    #   /storage/emulated/0/zyvo/<naam>/
    SDIR_ROOT="${WS_BASE:-$HOME}/zyvo"
    if [ -z "$SESSION_NAME" ]; then
        SESS_TMP="$TMPDIR/zyvo-session-list"
        : > "$SESS_TMP" 2>/dev/null || true
        if [ -d "$SDIR_ROOT" ]; then
            ls -1t "$SDIR_ROOT" 2>/dev/null | while read -r d; do
                [ -n "$d" ] && [ -d "$SDIR_ROOT/$d" ] && printf '%s\n' "$d" >> "$SESS_TMP"
            done
        fi
        echo "ZYVO sessions ($SDIR_ROOT):"
        if [ -s "$SESS_TMP" ]; then sed 's/^/  /' "$SESS_TMP"
        else echo "  (khali — notun banate: zyvo session <naam>)"; fi
        rm -f "$SESS_TMP" 2>/dev/null || true
        echo "Open/new: zyvo session <naam>"
        exit 0
    fi
    case "$SESSION_NAME" in
        ""|"."|".."|*[!A-Za-z0-9._-]*)
            echo "zyvo: session name e sudhu a-z 0-9 . _ - jabe (space/symbol nai)" >&2
            exit 1;;
    esac
    SDIR="$SDIR_ROOT/$SESSION_NAME"
    if mkdir -p "$SDIR" 2>/dev/null && [ -d "$SDIR" ]; then
        cd "$SDIR"
        export OPENCODE_DEFAULT_DIR="$SDIR"
    else
        echo "zyvo: session folder banate parlam na ($SDIR)" >&2
        exit 1
    fi
elif [ "$#" -eq 0 ] && [ "$PWD" = "$HOME" ]; then
    # Default workspace: dedicated folder (na hoy storage-root), sirf
    # directory argument chara home theke chalale.
    if [ -n "$WS_BASE" ]; then
        if mkdir -p "$WS_BASE/zyvo" 2>/dev/null && [ -d "$WS_BASE/zyvo" ]; then
            cd "$WS_BASE/zyvo"
            export OPENCODE_DEFAULT_DIR="$WS_BASE/zyvo"
        else
            cd "$WS_BASE"
            export OPENCODE_DEFAULT_DIR="$WS_BASE"
        fi
    fi
fi

# Set the terminal title so the toolbar shows ZYVO
if ( : >/dev/tty ) 2>/dev/null; then printf '\033]0;ZYVO\007' >/dev/tty 2>/dev/null; fi

# Locate the native libraries we ship alongside the wrapper.
# In the flat layout they sit next to the wrapper; in the Termux package
# layout they are under ../lib; on glibc Linux under ~/.local/lib/zyvo.
NATIVE_LIB_DIR=""
for candidate in \
    "$dir/../lib" \
    "${PREFIX:-/data/data/com.termux/files/usr}/lib" \
    "$HOME/.local/lib/zyvo" \
    "$dir"
do
    if [ -f "$candidate/libtagfix.so" ]; then
        NATIVE_LIB_DIR="$candidate"
        break
    fi
done

if [ -n "$NATIVE_LIB_DIR" ]; then
    export LD_PRELOAD="${NATIVE_LIB_DIR}/libtagfix.so${LD_PRELOAD:+:$LD_PRELOAD}"
    export LD_LIBRARY_PATH="${NATIVE_LIB_DIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export OPENTUI_LIB_PATH="${NATIVE_LIB_DIR}/libopentui.so"
    if [ -f "${NATIVE_LIB_DIR}/librust_pty_arm64.so" ]; then
        export BUN_PTY_LIB="${NATIVE_LIB_DIR}/librust_pty_arm64.so"
    fi
    export OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER="${OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER:-true}"
    if [ -x "$NATIVE_LIB_DIR/bun" ]; then
        export OPENCODE_BUN_PATH="$NATIVE_LIB_DIR/bun"
    fi
elif [ -n "$PREFIX" ] && [ -d "$PREFIX" ]; then
    # only warn on real Termux — glibc Linux e native lib lagbe na
    echo "zyvo: warning: native library directory not found, may crash on Android 11+" >&2
fi

# ---- auto-allow setup (YOLO) ----
# Native path: binary te OpenCode er nijer `--auto` flag thakle SETAI use
# kori (opencode 1.18+ e ache — deny rules respect kore, best). Purono
# android build (1.17.9) e flag nai — tokhon temp-config fallback.
# Detection ekbar kore stamp e cache hoy (binary change hole abar check).
apply_auto_allow() {
    if [ "$NATIVE_AUTO" = 1 ]; then
        echo "zyvo: auto-allow ON (native --auto) — kono permission prompt ashbe na (safe: zyvo --safe)" >&2
        return 0
    fi
    SESSION_FILE="$TMPDIR/zyvo-session-perm.json"
    cat > "$SESSION_FILE" <<'EOF'
{
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  }
}
EOF
    [ -n "$OPENCODE_CONFIG" ] && echo "zyvo: note: OPENCODE_CONFIG chhilo, session-perm replace koreche" >&2
    export OPENCODE_CONFIG="$SESSION_FILE"
    echo "zyvo: auto-allow ON — kono permission prompt ashbe na (safe: zyvo --safe)" >&2
}

# ---- in-chat session mode (/auto) auto-restore ----
# /auto ba /approve config e allow lekhhe (state+backup file so rakhhe).
# Ei wrapper holo parent process — tai zyvo exit korle ekhane restore kori.
# Crashed session er stale state thakle START e-i clean kori.
CFG_DIR="${HOME}/.config/opencode"
OC_STATE="$CFG_DIR/zyvo-session-state.json"
OC_BAK="$CFG_DIR/opencode.json.zyvo-session-bak"
OC_SETTINGS=""
for c in "$dir/oc-settings" \
    "${PREFIX:-/data/data/com.termux/files/usr}/bin/oc-settings" \
    "$HOME/.local/bin/oc-settings"
do
    if [ -x "$c" ]; then OC_SETTINGS="$c"; break; fi
done

session_cleanup() {
    [ -f "$OC_STATE" ] || [ -f "$OC_BAK" ] || return 0
    # onno LIVE zyvo session er state? take hug na — pid diye check.
    # (state e pid 0/manual thakle ba pid dead thakle restore koro)
    if [ -f "$OC_STATE" ]; then
        SPID="$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$OC_STATE" 2>/dev/null || true)"
        if [ -n "$SPID" ] && [ "$SPID" != "0" ] && [ "$SPID" != "$$" ] && kill -0 "$SPID" 2>/dev/null; then
            return 0
        fi
    fi
    if [ -n "$OC_SETTINGS" ]; then
        "$OC_SETTINGS" session restore >/dev/null 2>&1 || {
            [ -f "$OC_BAK" ] && mv "$OC_BAK" "$CFG_DIR/opencode.json" 2>/dev/null || true
            rm -f "$OC_STATE" 2>/dev/null || true
        }
    elif [ -f "$OC_BAK" ]; then
        mv "$OC_BAK" "$CFG_DIR/opencode.json" 2>/dev/null || true
        rm -f "$OC_STATE" 2>/dev/null || true
    fi
}

# stale state from a killed/crashed session? restore before launch
# (state er pid ekhono live? tahole onno zyvo session cholche — baad)
[ "$YOLO" = 0 ] && session_cleanup

# Locate the real binary. Prefer the package layout first so upgrades do not
# accidentally execute a stale flat-layout binary left in $PREFIX/bin.
BIN=""
for candidate in \
    "$dir/../libexec/opencode/opencode.bin" \
    "$HOME/.local/libexec/zyvo/opencode.bin" \
    "${PREFIX:-/data/data/com.termux/files/usr}/libexec/opencode/opencode.bin" \
    "$dir/opencode.bin" \
    "$HOME/.opencode/bin/opencode"
do
    if [ -x "$candidate" ]; then
        BIN="$candidate"
        break
    fi
done
[ -n "$BIN" ] || { echo "zyvo: error: could not find opencode.bin" >&2; exit 127; }

# native --auto detection (stamp cache — binary bodlale abar check hoy)
NATIVE_AUTO=""
AUTO_STAMP="$TMPDIR/zyvo-native-auto"
BIN_KEY="$(ls -ln "$BIN" 2>/dev/null | awk '{print $5, $6, $7, $8}')"
if [ -f "$AUTO_STAMP" ]; then
    case "$(cat "$AUTO_STAMP" 2>/dev/null)" in
        "$BIN_KEY yes") NATIVE_AUTO=1;;
        "$BIN_KEY no")  NATIVE_AUTO=0;;
    esac
fi
if [ -z "$NATIVE_AUTO" ]; then
    if "$BIN" --help 2>&1 | grep -q -- '--auto'; then NATIVE_AUTO=1; else NATIVE_AUTO=0; fi
    echo "$BIN_KEY $NATIVE_AUTO" > "$AUTO_STAMP" 2>/dev/null || true
fi

if [ "$YOLO" = 1 ]; then
    apply_auto_allow
    # native hole --auto flag diye exec; na hole OPENCODE_CONFIG (upore seta)
    if [ "$NATIVE_AUTO" = 1 ]; then
        if [ "$SESSION_MODE" = 1 ]; then exec "$BIN" --auto --continue "$@"; fi
        exec "$BIN" --auto "$@"
    fi
    if [ "$SESSION_MODE" = 1 ]; then exec "$BIN" --continue "$@"; fi
    exec "$BIN" "$@"
fi

# normal mode: child chole, exit e in-chat session state auto-restore
# (ZYVO_PID die oc-settings state file e ei wrapper er pid rekhe dey —
#  concurrent onno session er state accident-e restore na hoy tar jonno)
export ZYVO_PID="$$"
rc=0
if [ "$SESSION_MODE" = 1 ]; then
    "$BIN" --continue "$@" || rc=$?
else
    "$BIN" "$@" || rc=$?
fi
session_cleanup
exit $rc
