#!/data/data/com.termux/files/usr/bin/bash
# zyvo-vision — Vision bridge for ZYVO CLI
# Uses OpenCode Zen (mimo-v2.5-free) to describe images and videos
# Supports: .jpg .png .webp .gif .mp4 .mov .webm
# Model override: ZYVO_VISION_MODEL=<id> (default mimo-v2.5-free)
# Zen key priority: ZYVO_VISION_KEY > ~/.config/zyvo/vision-zen.key > OPENCODE_API_KEY > built-in default

set -e

FILE="$1"
PROMPT="${2:-Describe this image in detail. Include all text, UI elements, errors, colors, layout, and any notable details.}"

if [ -z "$FILE" ]; then
    echo "Usage: zyvo-vision <image-or-video> [prompt]"
    echo "Supports: jpg png webp gif mp4 mov webm"
    exit 1
fi

if [ ! -f "$FILE" ]; then
    echo "❌ File not found: $FILE"
    exit 1
fi

# Locate python3
if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "❌ Python is required for vision analysis" >&2
    exit 1
fi

ZEN_VISION_KEY_FILE="${HOME}/.config/zyvo/vision-zen.key"
if [ -z "${ZYVO_VISION_KEY:-}" ] && [ -f "$ZEN_VISION_KEY_FILE" ]; then
    ZYVO_VISION_KEY="$(tr -d '[:space:]' < "$ZEN_VISION_KEY_FILE" 2>/dev/null)"
fi
ZEN_KEYS="${ZYVO_VISION_KEY:-${OPENCODE_API_KEY:-sk-ZPCle2mleCGMXodtxMtbcQ5s9TUnJJvlRgiU52aukgGViDjFJj2FtOBHb3QRbcrs}}"
VISION_MODEL="${ZYVO_VISION_MODEL:-mimo-v2.5-free}"

exec "$PY" - "$FILE" "$PROMPT" "$ZEN_KEYS" "$VISION_MODEL" <<'PYVIS'
import sys, os, base64, json, subprocess, urllib.request, urllib.error, re, tempfile, time

# Termux python stdout is broken in some builds — write directly to fd 1.
def out(s):
    try:
        os.write(1, (str(s) + "\n").encode("utf-8", "replace"))
    except Exception:
        pass

# Termux has no /tmp — honor TMPDIR/TEMP/TMP before Python's /tmp default.
for _t in ("TMPDIR", "TEMP", "TMP"):
    _d = os.environ.get(_t)
    if _d and os.path.isdir(_d):
        tempfile.tempdir = _d
        break

file_path = os.path.abspath(sys.argv[1])
prompt = sys.argv[2]
raw_zen = sys.argv[3]
model = sys.argv[4] if len(sys.argv) > 4 else "mimo-v2.5-free"

zen_keys = [k.strip() for k in re.split(r'[,;\s\n]+', raw_zen) if k.strip()]

ext = os.path.splitext(file_path)[1].lower().lstrip(".")
mime_map = {
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "png": "image/png",
    "webp": "image/webp",
    "gif": "image/gif",
    "mp4": "video/mp4",
    "mov": "video/quicktime",
    "webm": "video/webm"
}
mime = mime_map.get(ext, "image/jpeg")
is_video = ext in ("mp4", "mov", "webm")

def analyze_zen_mimo(b64_data, mime_type, custom_prompt, key, model):
    url = "https://opencode.ai/zen/v1/chat/completions"
    data_url = f"data:{mime_type};base64,{b64_data}"
    payload = {
        "model": model,
        "messages": [
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": custom_prompt},
                    {"type": "image_url", "image_url": {"url": data_url}}
                ]
            }
        ],
        "max_tokens": 1500
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
            "User-Agent": "zyvo-vision/0.3.1 (Termux)"
        }
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        return data["choices"][0]["message"]["content"]

def analyze_zen_retry(b64_data, mime_type, custom_prompt, keys, model):
    """Rate limit (429) → exponential backoff (12/30/60s), 4 rounds across the key pool."""
    errors = []
    last = None
    waits = (12, 30, 60)
    for attempt in range(4):
        for k in keys:
            if not k:
                continue
            try:
                res = analyze_zen_mimo(b64_data, mime_type, custom_prompt, k, model)
                if res:
                    return res
            except urllib.error.HTTPError as e:
                tail = f"...{k[-6:]}" if len(k) > 6 else k
                errors.append(f"Zen ({tail}): HTTP {e.code}")
                last = f"[Zen error: HTTP {e.code}]"
                if e.code == 429:
                    time.sleep(waits[min(attempt, len(waits) - 1)])
            except Exception as e:
                tail = f"...{k[-6:]}" if len(k) > 6 else k
                errors.append(f"Zen ({tail}): {e}")
                last = f"[Zen error: {str(e)[:120]}]"
        if attempt < 3:
            time.sleep(5)
    if last:
        return last
    return f"[Analysis error across all keys: {'; '.join(errors[-2:])}]"

def shrink_image(img_path, max_px=1280):
    """Compress/resize before sending — small payloads hit rate limits far less.

    Same trick the TUI uses (that is why dropping the image in chat works
    while the raw bridge 429s). PIL preferred, ffmpeg fallback, else raw.
    """
    try:
        if os.path.getsize(img_path) < 300 * 1024:
            return img_path
    except Exception:
        return img_path
    try:
        from PIL import Image
        im = Image.open(img_path)
        im.thumbnail((max_px, max_px))
        out = tempfile.mktemp(suffix=".jpg", dir=tempfile.tempdir)
        im.convert("RGB").save(out, "JPEG", quality=85)
        return out
    except Exception:
        pass
    try:
        out = tempfile.mktemp(suffix=".jpg", dir=tempfile.tempdir)
        subprocess.run(
            ["ffmpeg", "-y", "-i", img_path, "-vf",
             f"scale={max_px}:{max_px}:force_original_aspect_ratio=decrease", "-q:v", "3", out],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        if os.path.getsize(out) > 0:
            return out
    except Exception:
        pass
    return img_path

def analyze_frame(img_path, frame_prompt):
    use_path = shrink_image(img_path)
    with open(use_path, "rb") as fh:
        b64 = base64.b64encode(fh.read()).decode("utf-8")
    if use_path != img_path:
        try:
            os.remove(use_path)
        except Exception:
            pass
    
    frame_mime = "image/jpeg" if is_video else mime
    errors = []

    res = analyze_zen_retry(b64, frame_mime, frame_prompt, zen_keys, model)
    if res and not (res.startswith("[Zen error") or res.startswith("[Analysis error")):
        return res
    if res:
        errors.append(res)

    return f"[Analysis error across all keys: {'; '.join(errors[-2:])}]"

if is_video:
    import tempfile, shutil
    tmp_dir = tempfile.mkdtemp(prefix="zyvo-vid-")
    try:
        dur_cmd = ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", file_path]
        try:
            dur_str = subprocess.check_output(dur_cmd, stderr=subprocess.DEVNULL).decode().strip()
            duration = max(1, int(float(dur_str)))
        except Exception:
            duration = 6

        t_points = [0, duration // 2, max(0, duration - 1)]
        frames = []
        for i, t in enumerate(t_points):
            out_img = os.path.join(tmp_dir, f"frame_{i+1}.jpg")
            ff_cmd = ["ffmpeg", "-ss", str(t), "-i", file_path, "-frames:v", "1", "-q:v", "2", out_img, "-y"]
            subprocess.run(ff_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(out_img):
                frames.append((i+1, t, out_img))

        if not frames:
            out("❌ ffmpeg could not extract frames from video.")
            sys.exit(1)

        out(f"🎬 Video Analysis ({os.path.basename(file_path)}, {duration}s):\n")
        labels = ["Opening / Start", "Middle Scene", "Ending / Payoff"]
        for i, t, fpath in frames:
            lbl = labels[i-1] if i <= len(labels) else f"Frame {i}"
            fprompt = f"This is frame {i} of 3 ({lbl}, at {t}s) from video {os.path.basename(file_path)}. {prompt}"
            desc = analyze_frame(fpath, fprompt)
            out(f"--- Frame {i} [{lbl} at {t}s] ---")
            out(desc)
            out("")
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)
else:
    out(f"📷 Image Analysis ({os.path.basename(file_path)}):\n")
    desc = analyze_frame(file_path, prompt)
    out(desc)

PYVIS
