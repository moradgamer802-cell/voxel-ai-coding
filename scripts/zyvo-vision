#!/data/data/com.termux/files/usr/bin/bash
# zyvo-vision — Vision bridge for ZYVO CLI
# Uses OpenCode Zen (mimo-v2.5-free) / Gemini Flash to describe images and videos
# Supports: .jpg .png .webp .gif .mp4 .mov .webm

set -e

FILE="$1"
PROMPT="${2:-Describe this image in detail. Include all text, UI elements, errors, colors, layout, and any notable details.}"

if [ -z "$FILE" ]; then
    echo "Usage: zyvo-vision <image-or-video> [prompt]"
    echo "Supports: jpg png webp gif mp4 mov webm"
    exit 1
fi

if [ ! -f "$FILE" ]; then
    echo "❌ File not found: $FILE"
    exit 1
fi

# Locate python3
if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "❌ Python is required for vision analysis" >&2
    exit 1
fi

ZEN_KEY="${OPENCODE_API_KEY:-sk-PKOWRt2391BL0MP3W90yaG8qx4vofQJQgigJreBBYjrArj0lwuU1HkWUqOHgDGHP}"
VISION_KEY_FILE="${HOME}/.config/zyvo/vision.key"
GEMINI_KEY="${GEMINI_API_KEY:-}"
[ -z "$GEMINI_KEY" ] && [ -f "$VISION_KEY_FILE" ] && GEMINI_KEY="$(cat "$VISION_KEY_FILE" | tr -d '[:space:]')"

exec "$PY" - "$FILE" "$PROMPT" "$ZEN_KEY" "$GEMINI_KEY" <<'PYVIS'
import sys, os, base64, json, subprocess, urllib.request, urllib.error

file_path = os.path.abspath(sys.argv[1])
prompt = sys.argv[2]
zen_key = sys.argv[3]
gemini_key = sys.argv[4] if len(sys.argv) > 4 else ""

ext = os.path.splitext(file_path)[1].lower().lstrip(".")
mime_map = {
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "png": "image/png",
    "webp": "image/webp",
    "gif": "image/gif",
    "mp4": "video/mp4",
    "mov": "video/quicktime",
    "webm": "video/webm"
}
mime = mime_map.get(ext, "image/jpeg")
is_video = ext in ("mp4", "mov", "webm")

def analyze_zen_mimo(b64_data, mime_type, custom_prompt):
    url = "https://opencode.ai/zen/v1/chat/completions"
    data_url = f"data:{mime_type};base64,{b64_data}"
    payload = {
        "model": "mimo-v2.5-free",
        "messages": [
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": custom_prompt},
                    {"type": "image_url", "image_url": {"url": data_url}}
                ]
            }
        ],
        "max_tokens": 1500
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {zen_key}"
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["choices"][0]["message"]["content"]
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        raise RuntimeError(f"Zen API error ({e.code}): {err_msg}")
    except Exception as e:
        raise RuntimeError(f"Zen request failed: {e}")

def analyze_gemini(b64_data, mime_type, custom_prompt, key):
    if not key:
        return None
    url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={key}"
    payload = {
        "contents": [{
            "parts": [
                {"text": custom_prompt},
                {"inline_data": {"mime_type": mime_type, "data": b64_data}}
            ]
        }]
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["candidates"][0]["content"]["parts"][0]["text"]
    except Exception:
        return None

def analyze_frame(img_path, frame_prompt):
    with open(img_path, "rb") as fh:
        b64 = base64.b64encode(fh.read()).decode("utf-8")
    
    # Try Zen mimo-v2.5-free first
    try:
        res = analyze_zen_mimo(b64, "image/jpeg" if is_video else mime, frame_prompt)
        if res:
            return res
    except Exception as zen_err:
        # Fallback to Gemini if configured
        if gemini_key:
            res = analyze_gemini(b64, "image/jpeg" if is_video else mime, frame_prompt, gemini_key)
            if res:
                return res
        return f"[Analysis error: {zen_err}]"

if is_video:
    import tempfile, shutil
    tmp_dir = tempfile.mkdtemp(prefix="zyvo-vid-")
    try:
        dur_cmd = ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", file_path]
        try:
            dur_str = subprocess.check_output(dur_cmd, stderr=subprocess.DEVNULL).decode().strip()
            duration = max(1, int(float(dur_str)))
        except Exception:
            duration = 6

        t_points = [0, duration // 2, max(0, duration - 1)]
        frames = []
        for i, t in enumerate(t_points):
            out_img = os.path.join(tmp_dir, f"frame_{i+1}.jpg")
            ff_cmd = ["ffmpeg", "-ss", str(t), "-i", file_path, "-frames:v", "1", "-q:v", "2", out_img, "-y"]
            subprocess.run(ff_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(out_img):
                frames.append((i+1, t, out_img))

        if not frames:
            print("❌ ffmpeg could not extract frames from video.")
            sys.exit(1)

        print(f"🎬 Video Analysis ({os.path.basename(file_path)}, {duration}s):\n")
        labels = ["Opening / Start", "Middle Scene", "Ending / Payoff"]
        for i, t, fpath in frames:
            lbl = labels[i-1] if i <= len(labels) else f"Frame {i}"
            fprompt = f"This is frame {i} of 3 ({lbl}, at {t}s) from video {os.path.basename(file_path)}. {prompt}"
            desc = analyze_frame(fpath, fprompt)
            print(f"--- Frame {i} [{lbl} at {t}s] ---")
            print(desc)
            print()
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)
else:
    print(f"📷 Image Analysis ({os.path.basename(file_path)}):\n")
    desc = analyze_frame(file_path, prompt)
    print(desc)

PYVIS
