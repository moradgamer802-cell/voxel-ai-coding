{
  "$schema": "https://opencode.ai/config.json",
  "username": "deshi-dev",
  "provider": {
    "zyvo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zyvo (Zen)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "model": "zyvo/deepseek-v4-flash-free",
  "small_model": "zyvo/ling-3.0-tiny-free",
  "default_agent": "build",
  "permission": {
    "bash": "ask",
    "edit": "ask"
  }
}